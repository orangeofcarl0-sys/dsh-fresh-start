{
  "name": "dsh-fresh-start",
  "version": "1.7.0",
  "description": "DSH /fresh 命令：一键总结当前对话 → 开启新对话 → 归档老对话（缓解超大会话内存/卡顿，DeepSeek Harness / DSH）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node tests/smoke_test.mjs && node tests/client_test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangeofcarl0-sys/dsh-fresh-start.git"
  },
  "bugs": {
    "url": "https://github.com/orangeofcarl0-sys/dsh-fresh-start/issues"
  },
  "homepage": "https://github.com/orangeofcarl0-sys/dsh-fresh-start#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compact",
    "archive",
    "fresh"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
